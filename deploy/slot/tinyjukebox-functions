# shellcheck shell=bash
# what the start script and tinyjukebox-slot share: paths, the files in state/, switching (docs/developer/library.md, sections 6.1 to 6.11)
# sourced, not executed. Lives outside the slots and changes only through the installer (deploy/install/install.sh).
#
# /srv/tinyjukebox/
#   slots/a, slots/b, slots/fallback    a version each;  slots/next: installed, moves into its slot on the next start
#   current -> slots/b                  the only truth about which slot runs
#   state/slots                         "<slot> <version> <state> <since> <starts>" and "newest <version>"
#   state/versions                      "<version> <state> <revision> [box]": copy of the library; "box" marks an own
#                                       change that the library does not know yet
#   state/update                        automatic | manual | off
#   state/history.log                   one line per switch: when, from, to, why, by whom, details (tabs)
#   state/refused                       "<version> <checksum>": archives this box refused; not fetched again by itself
#                                       as long as the key of the releases is the one in state/refused.key
#   state/skipped                       a release an admin skipped on a box that asks before it installs
#   state/versions.json, release.json   what the library offers, or - on a box without a library - the newest release
#                                       of the git server as it answered (section 6.16)
#   state/active, check, trigger, switch, discard, library, problem, failure, stage1: see where they are written
#
# states of a slot: probation, confirmed, abandoned. The line "next" names how its version was installed instead:
# auto (by the box itself), probation (by hand), check (by hand, an older version: no probation)
#
# A note in state/ is written to a new file that is then renamed (note): a power cut leaves the old note or the new
# one, never half of one. What the scripts read there is checked; an empty or damaged note counts as no note.

SCRIPT_VERSION=2
ROOT=${ROOT:-}
BASE=$ROOT/srv/tinyjukebox
BOOT=$ROOT/boot/firmware
SLOTS=$BASE/slots
STATE=$BASE/state
IDENTITY=$BASE/identity
SCRIPTS=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")  # where the start script and tinyjukebox-slot are

say() { printf '%s\n' "$*"; }
fail() { printf 'tinyjukebox-slot: %s\n' "$*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# the files below BASE belong to the user of the service, slot.conf too. Written as root they would belong to root from
# then on, and the service could not replace them any more. As root only on a mounted card (--root)
if [ "$(id -u)" = 0 ] && [ -z "$ROOT" ]; then
    OWNER=$(stat -c %U "$BASE" 2> /dev/null || echo "the user of the service")
    fail "not as root: the files of $BASE belong to $OWNER - run it as that user, e.g. sudo -u $OWNER $(basename "$0") ..."
fi

# the values of this box, written by the installer into slot.conf
STAGE1_LIMIT=120                                   # seconds a version may take to pass stage 1 of the health check
SETUP_LEVEL=1                                      # level of the setup that the installer made
RESTART_COMMAND="sudo systemctl restart tinyjukebox"
RELEASES=                                          # where a box without a library finds its versions: the address
                                                   # of the repository at the git server, https://api.github.com/repos/<owner>/<name>
WAIT_DAYS=3                                        # days a release waits before such a box installs it by itself
RECOVERY_WAIT=600                                  # seconds between two attempts of recovery mode to install a version
PLATFORM=
# shellcheck source=/dev/null
[ -f "$BASE/slot.conf" ] && . "$BASE/slot.conf"
if [ -z "$PLATFORM" ]; then
    PLATFORM=$(uname -m)-$(. "$ROOT/etc/os-release" && echo "$ID-$VERSION_CODENAME")
fi

# seconds since the boot: a clock that never jumps. The Pi has no real-time clock - it starts with the time it was
# switched off at, and the clock of the system jumps forward by hours when it is set from the network. $SECONDS of
# bash follows that clock. UPTIME_FILE is for the tests
uptime_seconds() { local up _; read -r up _ < "${UPTIME_FILE:-/proc/uptime}"; echo "${up%%.*}"; }
as_root() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }
other() { case $1 in a) echo b ;; b) echo a ;; esac; }

# test bed: stop at a named place, so that the driver can cut the power exactly there (library.md, section 9.4)
breakpoint() {
    [ "$(cat "$BASE/testbed/breakpoint" 2>/dev/null)" = "$1" ] || return 0
    echo "$1" > "$BASE/testbed/breakpoint.reached"
    sleep infinity
}

note() {  # name text [sync]: a note in state/, replaced in one step. "sync": a switch depends on it, it must be on the card
    local new=$STATE/.$1.new
    printf '%s\n' "$2" > "$new" || return 1
    [ "${3:-}" != sync ] || sync "$new" 2> /dev/null
    mv -f "$new" "$STATE/$1" || return 1
    [ "${3:-}" != sync ] || sync -f "$STATE" 2> /dev/null
    return 0
}

# versions are X.Y.Z. sort -V would put 0.21.0rc1 after 0.21.0: anything else is never installed or compared
is_version() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
version_gt() {  # a b: a is a higher version than b. A b that is no version - none at all - is lower than every version
    is_version "$1" || return 1
    is_version "$2" || return 0
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# --- state/slots -------------------------------------------------------------------------------------------------------

slot_field() { [ -f "$STATE/slots" ] && awk -v slot="$1" -v field="$2" '$1 == slot { print $field }' "$STATE/slots"; }
slot_version() { slot_field "$1" 2; }
slot_state() { slot_field "$1" 3; }
slot_drop() {
    [ -f "$STATE/slots" ] || return 0
    awk -v slot="$1" '$1 != slot' "$STATE/slots" > "$STATE/slots.new" && mv "$STATE/slots.new" "$STATE/slots"
}
slot_set() {  # slot version state [since] [starts]: the line of a slot. A slot without a line is never started
    case $1 in a | b | fallback | next) ;; *) say "no slot '$1': state/slots stays as it is"; return 1 ;; esac
    [ -n "$2" ] || { say "slot $1 without a version: state/slots stays as it is"; return 1; }
    local starts=${5:-0}
    case $starts in *[!0-9]*) starts=0 ;; esac  # a number, or "status --json" could not read the file
    # replaced in one step: "tinyjukebox-slot status" reads the file without the lock and never sees a slot missing
    {
        [ -f "$STATE/slots" ] && awk -v slot="$1" '$1 != slot' "$STATE/slots"
        echo "$1 $2 $3 ${4:--} $starts"
    } | sort > "$STATE/slots.new"
    mv "$STATE/slots.new" "$STATE/slots"
}
slot_restate() { slot_set "$1" "$(slot_version "$1")" "$2" "$(slot_field "$1" 4)" "$(slot_field "$1" 5)"; }
slot_usable() {
    [ -n "$1" ] && [ "$1" != next ] && [ -n "$(slot_version "$1")" ] && [ -x "$SLOTS/$1/bin/tinyjukebox" ]
}
newest() { slot_field newest 2; }
slot_newest() {  # version: the newest version this box has run - in state/slots, which is replaced in one step
    {
        [ -f "$STATE/slots" ] && awk '$1 != "newest"' "$STATE/slots"
        echo "newest $1"
    } > "$STATE/slots.new"
    mv "$STATE/slots.new" "$STATE/slots"
}
mode() {  # an empty or damaged state/update counts as none: automatic
    local mode
    mode=$(cat "$STATE/update" 2> /dev/null)
    case $mode in automatic | manual | off) echo "$mode" ;; *) echo automatic ;; esac
}
active() { readlink "$BASE/current" 2>/dev/null | sed 's|^slots/||'; }
describe() { echo "$1:$(slot_version "$1")"; }

# --- state/versions ----------------------------------------------------------------------------------------------------

version_state() {  # a version the library has not listed counts as use
    local state
    state=$(awk -v version="$1" '$1 == version { print $2 }' "$STATE/versions" 2>/dev/null)
    echo "${state:-use}"
}
version_left() {  # this box went back from a version: manual, until the library knows (section 6.2)
    is_version "$1" || return 0
    [ "$(version_state "$1")" = use ] || return 0
    local revision
    revision=$(awk -v version="$1" '$1 == version { print $3 }' "$STATE/versions" 2>/dev/null)
    { awk -v version="$1" '$1 != version' "$STATE/versions" 2>/dev/null; echo "$1 manual ${revision:-0} box"; } \
        | sort -V > "$STATE/versions.new"
    mv "$STATE/versions.new" "$STATE/versions"
    say "version $1 is manual now: no box installs it by itself any more"
}

# --- switching -----------------------------------------------------------------------------------------------------------

history() {  # from to why by [details]
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "$3" "$4" "${5:-}" >> "$STATE/history.log"
    say "$3: $1 -> $2 (by $4)${5:+, $5}"
}
point_to() {  # the link is replaced in one step and is relative, so it is right wherever the card is mounted
    case $1 in a | b | fallback) ;; *) say "no slot '$1' to switch to: the link current stays as it is"; return 1 ;; esac
    ln -sfn "slots/$1" "$BASE/current.new"
    mv -T "$BASE/current.new" "$BASE/current"
    sync -f "$BASE" 2> /dev/null
    note active "$1"  # what the scripts noted last: a link changed without them is detected by this
}
abandon() {  # the box goes back from the version in this slot
    slot_restate "$1" abandoned
    version_left "$(slot_version "$1")"
}
problem() { note problem "$*"; say "problem: $*"; }

# the slot that takes the installed version: the slot with the last confirmed version stays (section 6.3)
next_target() {
    local act
    act=$(active)
    case $act in
        a | b) if [ "$(slot_state "$act")" = confirmed ]; then other "$act"; else echo "$act"; fi ;;
        *) if [ "$(slot_state a)" = confirmed ] && [ "$(slot_state b)" != confirmed ]; then echo b; else echo a; fi ;;
    esac
}

# a slot is modified if a file differs from the list of checksums it brought along (section 6.12)
slot_modified() { [ -f "$SLOTS/$1/SHA256SUMS" ] && ! (cd "$SLOTS/$1" && sha256sum --quiet -c SHA256SUMS > /dev/null 2>&1); }
