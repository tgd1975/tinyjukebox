# Tiny Jukebox box with slots (docs/developer/library.md, section 6): the unit starts the start script, which
# selects the slot, starts the application of that version as its child and watches a version that is on probation.
# Installed by the installer (deploy/install/install.sh); logs: /srv/tinyjukebox/log/tinyjukebox.log (warnings and what the start script
# says also in 'journalctl -u tinyjukebox').
[Unit]
Description=Tiny Jukebox
# bluetooth/bluealsa: only the order (if they are installed) - without them the box runs without headset
# no network-online.target: the box plays without wlan, and the web server listens on 0.0.0.0
After=sound.target bluetooth.service bluealsa.service
# never give up restarting - nobody is there to start the box by hand; RestartSteps slows a restart loop down instead
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
# writable: lgpio creates its .lgd-nfy* files in the working directory
WorkingDirectory=/srv/tinyjukebox
# the web page listens on port 443 - ports below 1024 need this capability if the user is not root
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/tinyjukebox-start
# the stop signal goes to the start script only, which passes it on to the application and waits for it; what is left
# after that (a player, rfid-reader) is ended by systemd
KillMode=mixed
# a version that fails its health check makes the start script end with an error: the restart starts the version
# before. An application that was stopped is no failure
Restart=on-failure
# first restart after 2 s, every further one later, at most every 30 s (systemd >= 254, i.e. Debian trixie) - a box that
# fails again and again (e.g. broken config) neither keeps the pi busy nor floods the journal
RestartSec=2
RestartSteps=4
RestartMaxDelaySec=30

[Install]
WantedBy=multi-user.target
