{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configuration of the Tiny Jukebox box.",
    "type": "object",
    "properties": {
        "tinyjukebox": {
            "description": "Tiny Jukebox box",
            "type": "object",
            "properties": {
                "albums-folder": {
                    "description": "root folder of all albums - album folders in the targets json are relative to it",
                    "type": "string"
                },
                "playlist-filename": {
                    "description": "name of the m3u playlist in each album folder (e.g. playlist.m3u)",
                    "type": "string"
                },
                "volume": {
                    "type": "object",
                    "properties": {
                        "max-volume": {
                            "description": "maximum volume in %",
                            "type": "number"
                        },
                        "default-volume": {
                            "description": "volume on startup in %",
                            "type": "number"
                        },
                        "volume-step": {
                            "description": "change of the volume per button press in %",
                            "type": "number"
                        },
                        "volume-step-hold": {
                            "description": "change of the volume in % per hold event of a volume button that is kept pressed (optional, default: 1) - 'hold_timeout' and 'hold_repeat' of its input driver say how often",
                            "type": "number",
                            "minimum": 0
                        },
                        "mixer-control": {
                            "description": "alsa mixer control of the default card (default: Master) - list: 'amixer scontrols'",
                            "type": "string"
                        }
                    },
                    "required": [
                        "max-volume",
                        "default-volume",
                        "volume-step"
                    ],
                    "additionalProperties": false
                },
                "bluetooth": {
                    "description": "volume of the bluetooth headset (optional) - start value and maximum of speaker and headset can be changed at runtime (web page, command line); the changed values are stored in the volume json file and apply instead of the config",
                    "type": "object",
                    "properties": {
                        "default-volume": {
                            "description": "volume in % whenever the headset connects (default: 40)",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        },
                        "max-volume": {
                            "description": "maximum volume of the headset in % (default: 75) - 100: the box does not limit it",
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "additionalProperties": false
                },
                "albumplayer": {
                    "type": "object",
                    "properties": {
                        "rewind-max-time": {
                            "description": "'previous' within this many seconds of a track goes to the previous track, later it restarts the current track",
                            "type": "number"
                        },
                        "update-schedule": {
                            "description": "store the playback position every n seconds",
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "pause-between-tracks": {
                            "description": "pause between two tracks in seconds",
                            "type": "number",
                            "minimum": 0
                        },
                        "buffer-time": {
                            "description": "alsa buffer of aplay in ms (optional, default: aplay's default, usually 500 ms) - smaller starts the sound faster; raise it if the sound stutters",
                            "type": "number",
                            "minimum": 20,
                            "maximum": 2000
                        }
                    },
                    "required": [
                        "rewind-max-time",
                        "update-schedule",
                        "pause-between-tracks"
                    ],
                    "additionalProperties": false
                },
                "json": {
                    "type": "object",
                    "properties": {
                        "tags": {
                            "description": "tags json file, e.g. /srv/tinyjukebox/json/tags.json",
                            "type": "string"
                        },
                        "targets": {
                            "description": "targets (albums) json file, e.g. /srv/tinyjukebox/json/targets.json",
                            "type": "string"
                        },
                        "activities": {
                            "description": "activities json file, e.g. /srv/tinyjukebox/json/activity.json",
                            "type": "string"
                        },
                        "volume": {
                            "description": "start value and maximum of the volumes changed at runtime (optional, default: volume.json next to the tags json)",
                            "type": "string"
                        }
                    },
                    "required": [
                        "tags",
                        "targets",
                        "activities"
                    ],
                    "additionalProperties": false
                },
                "sync": {
                    "description": "synchronization with the library (optional) - the box works with a library as soon as its address was entered (web page, or the file 'library' in the identity folder)",
                    "type": "object",
                    "properties": {
                        "folder": {
                            "description": "what the library delivered, the changes of this box that it has not confirmed, the journal (default: folder 'sync' next to the folder of the tags json)",
                            "type": "string"
                        },
                        "identity": {
                            "description": "what identifies this box: its id, its key, address and certificate of the library (default: folder 'identity' next to the folder of the tags json)",
                            "type": "string"
                        },
                        "retry-seconds": {
                            "description": "how often the library is tried again while it cannot be reached (default: 30)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "keep-free": {
                            "description": "MB that stay free on the card of a box that works with a library (default: 500, 0: never delete): when less is free, the audio files of albums are deleted here, the album not played for the longest time first - the library has them, and they are fetched again when their tag is placed",
                            "type": "number",
                            "minimum": 0
                        },
                        "stage1-seconds": {
                            "description": "health check of a new version: seconds after the start in which no unexpected exception may occur and everything must run (default: 10)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "stage2-seconds": {
                            "description": "health check of a new version: seconds an album must have played without an unexpected exception before the version is confirmed (default: 60)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "look-hours": {
                            "description": "a box with slots and without a library: hours between two looks for a new version at the releases of the git server (default: 24)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "additionalProperties": false
                },
                "rest-api": {
                    "description": "https rest api and web page (optional)",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "default: true",
                            "type": "boolean"
                        },
                        "host": {
                            "description": "address to listen on (default: 0.0.0.0)",
                            "type": "string"
                        },
                        "port": {
                            "description": "default: 8443",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                        },
                        "certificate": {
                            "description": "certificate file (pem) - a self signed certificate is created if it does not exist (default: ~/.config/tinyjukebox/tinyjukebox.crt)",
                            "type": "string"
                        },
                        "private-key": {
                            "description": "private key file (pem, default: ~/.config/tinyjukebox/tinyjukebox.key)",
                            "type": "string"
                        },
                        "hostnames": {
                            "description": "additional host names / ip addresses for the self signed certificate",
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "users-file": {
                            "description": "users and password hashes - manage with 'tinyjukebox-users' (default: ~/.config/tinyjukebox/users.yaml)",
                            "type": "string"
                        },
                        "images-folder": {
                            "description": "covers of the radio stations (default: folder 'images' next to the tags json)",
                            "type": "string"
                        },
                        "session-timeout": {
                            "description": "logout after this many seconds without request (default: 604800 = 7 days)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        },
                        "idle-timeout": {
                            "description": "logout after this many seconds in which the user of the page did nothing (default: 1800 = 30 minutes; 0: never)",
                            "type": "number",
                            "minimum": 0
                        },
                        "max-upload-size": {
                            "description": "maximum size of an uploaded mp3 file in MB (default: 500)",
                            "type": "number",
                            "exclusiveMinimum": 0
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "volume",
                "albums-folder",
                "playlist-filename",
                "albumplayer",
                "json"
            ],
            "additionalProperties": false
        },
        "logger": {
            "description": "Logger configuration",
            "type": "object",
            "properties": {
                "log-level": {
                    "description": "Log level to be used.",
                    "type": "string",
                    "enum": [
                        "DEBUG",
                        "INFO",
                        "WARNING",
                        "ERROR",
                        "CRITICAL"
                    ]
                },
                "log-file": {
                    "description": "File name for the logger.",
                    "type": "string"
                },
                "log-rotation": {
                    "description": "Parameters for log rotation (optional).",
                    "type": "object",
                    "properties": {
                        "maxbytes": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Rollover occurs whenever the current log file is nearly maxbytes in length."
                        },
                        "backupcount": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "With a backupcount of 5 and a base file name of app.log, you would get app.log, app.log.1, app.log.2, up to app.log.5."
                        }
                    },
                    "required": [
                        "maxbytes",
                        "backupcount"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "log-level",
                "log-file"
            ],
            "additionalProperties": false
        },
        "drivers": {
            "description": "Drivermanager configuration.",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "description": "type of driver",
                        "enum": [
                            "input",
                            "rfid",
                            "rgbled",
                            "bluetooth"
                        ]
                    }
                },
                "required": [
                    "type"
                ],
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "input"
                                }
                            }
                        },
                        "then": {
                            "description": "Driver configuration 'input'.",
                            "type": "object",
                            "properties": {
                                "name": {
                                    "description": "name of driver",
                                    "type": "string"
                                },
                                "type": {
                                    "description": "type of driver",
                                    "type": "string",
                                    "enum": [
                                        "input"
                                    ]
                                },
                                "pin": {
                                    "description": "gpio pin",
                                    "type": "integer"
                                },
                                "hold_timeout": {
                                    "description": "hold time in seconds until the hold event is triggered",
                                    "type": "number"
                                },
                                "button": {
                                    "description": "which button of the box",
                                    "type": "string",
                                    "enum": [
                                        "volume-up",
                                        "volume-down",
                                        "next",
                                        "prev",
                                        "play",
                                        "pause"
                                    ]
                                },
                                "hold_repeat": {
                                    "description": "repeat the hold event every hold_timeout seconds while the button stays pressed (optional, default: false)",
                                    "type": "boolean"
                                },
                                "active": {
                                    "description": "if set to false, the driver is not loaded",
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "type",
                                "pin",
                                "hold_timeout",
                                "button",
                                "name",
                                "active"
                            ],
                            "additionalProperties": false
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "rfid"
                                }
                            }
                        },
                        "then": {
                            "description": "Driver configuration 'rfid'.",
                            "type": "object",
                            "properties": {
                                "name": {
                                    "description": "name of driver",
                                    "type": "string"
                                },
                                "type": {
                                    "description": "type of driver",
                                    "type": "string",
                                    "enum": [
                                        "rfid"
                                    ]
                                },
                                "pins": {
                                    "description": "rfid reader pins (BCM numbers)",
                                    "type": "object",
                                    "properties": {
                                        "pin_rst": {
                                            "description": "reset pin",
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 53
                                        },
                                        "pin_cs": {
                                            "description": "chip select, e.g. 8 for SPI0 CE0",
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 53
                                        }
                                    },
                                    "required": [
                                        "pin_rst",
                                        "pin_cs"
                                    ],
                                    "additionalProperties": false
                                },
                                "command": {
                                    "description": "command that starts rfid-reader (optional, default: sudo -n /usr/local/bin/rfid-reader); the pins are appended as arguments",
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 1
                                },
                                "active": {
                                    "description": "if set to false, the driver is not loaded",
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "type",
                                "pins",
                                "name",
                                "active"
                            ],
                            "additionalProperties": false
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "rgbled"
                                }
                            }
                        },
                        "then": {
                            "description": "Driver configuration 'rgbled'.",
                            "type": "object",
                            "properties": {
                                "name": {
                                    "description": "name of driver",
                                    "type": "string"
                                },
                                "type": {
                                    "description": "type of driver",
                                    "type": "string",
                                    "enum": [
                                        "rgbled"
                                    ]
                                },
                                "initial-color": {
                                    "description": "color at startup",
                                    "type": "string",
                                    "enum": [
                                        "BLACK",
                                        "WHITE",
                                        "RED",
                                        "GREEN",
                                        "BLUE",
                                        "YELLOW",
                                        "AQUA",
                                        "MAGENTA"
                                    ]
                                },
                                "pin-red": {
                                    "description": "gpio pin red",
                                    "type": "integer"
                                },
                                "physical-closed-red": {
                                    "description": "low/high - gpio level that switches the color on",
                                    "type": "string",
                                    "enum": [
                                        "low",
                                        "high"
                                    ]
                                },
                                "pin-green": {
                                    "description": "gpio pin green",
                                    "type": "integer"
                                },
                                "physical-closed-green": {
                                    "description": "low/high - gpio level that switches the color on",
                                    "type": "string",
                                    "enum": [
                                        "low",
                                        "high"
                                    ]
                                },
                                "pin-blue": {
                                    "description": "gpio pin blue",
                                    "type": "integer"
                                },
                                "physical-closed-blue": {
                                    "description": "low/high - gpio level that switches the color on",
                                    "type": "string",
                                    "enum": [
                                        "low",
                                        "high"
                                    ]
                                },
                                "active": {
                                    "description": "if set to false, the driver is not loaded",
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "type",
                                "initial-color",
                                "pin-red",
                                "physical-closed-red",
                                "pin-green",
                                "physical-closed-green",
                                "pin-blue",
                                "physical-closed-blue",
                                "name",
                                "active"
                            ],
                            "additionalProperties": false
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "type": {
                                    "const": "bluetooth"
                                }
                            }
                        },
                        "then": {
                            "description": "Driver configuration 'bluetooth'.",
                            "type": "object",
                            "properties": {
                                "name": {
                                    "description": "name of driver",
                                    "type": "string"
                                },
                                "type": {
                                    "description": "type of driver",
                                    "type": "string",
                                    "enum": [
                                        "bluetooth"
                                    ]
                                },
                                "adapter": {
                                    "description": "bluetooth adapter (optional, default: hci0)",
                                    "type": "string"
                                },
                                "avrcp": {
                                    "description": "how the buttons of the headset arrive (optional, default: player) - player: BlueZ calls the media player the box registers; input: BlueZ passes them to the linux input device '<headset> (AVRCP)' (the user needs the group input)",
                                    "type": "string",
                                    "enum": [
                                        "player",
                                        "input"
                                    ]
                                },
                                "play-pause-toggle": {
                                    "description": "play and pause of the headset both switch between play and pause (optional, default: false) - for headsets that send the same button for both",
                                    "type": "boolean"
                                },
                                "active": {
                                    "description": "if set to false, the driver is not loaded",
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "type",
                                "name",
                                "active"
                            ],
                            "additionalProperties": false
                        }
                    }
                ]
            }
        }
    },
    "required": [
        "tinyjukebox",
        "logger"
    ],
    "definitions": {}
}